# Dynamic Partitions (EROFS & EXT4)
/system             erofs     system                                      flags=display="System";logical;slotselect;backup=1
/system             ext4      system                                      flags=display="System (EXT4)";logical;slotselect
/system_ext         erofs     system_ext                                  flags=display="System_EXT";logical;slotselect;backup=1
/system_ext         ext4      system_ext                                  flags=display="System_EXT (EXT4)";logical;slotselect
/vendor             erofs     vendor                                      flags=display="Vendor";logical;slotselect;backup=1
/vendor             ext4      vendor                                      flags=display="Vendor (EXT4)";logical;slotselect
/product            erofs     product                                     flags=display="Product";logical;slotselect;backup=1
/product            ext4      product                                     flags=display="Product (EXT4)";logical;slotselect
/mi_ext             erofs     mi_ext                                      flags=display="MI_EXT";logical;slotselect;backup=1
/mi_ext             ext4      mi_ext                                      flags=display="MI_EXT (EXT4)";logical;slotselect
/vendor_dlkm        erofs     vendor_dlkm                                 flags=display="Vendor_DLKM";logical;slotselect;backup=1
/vendor_dlkm        ext4      vendor_dlkm                                 flags=display="Vendor_DLKM (EXT4)";logical;slotselect
/odm_dlkm           erofs     odm_dlkm                                    flags=display="ODM_DLKM";logical;slotselect;backup=1
/odm_dlkm           ext4      odm_dlkm                                    flags=display="ODM_DLKM (EXT4)";logical;slotselect
/system_dlkm        erofs     system_dlkm                                 flags=display="System_DLKM";logical;slotselect;backup=1
/system_dlkm        ext4      system_dlkm                                 flags=display="System_DLKM (EXT4)";logical;slotselect

# Super Partition (Raw Image Backup)
/super_image        emmc      /dev/block/by-name/super                    flags=display="Super (Imagen Completa)";backup=1;flashimg=1

# Userdata & Metadata (F2FS + FBEv2 + Metadata Encryption)
/metadata           ext4      /dev/block/by-name/metadata                 flags=display="Metadata";backup=1;wrappedkey
/data               f2fs      /dev/block/by-name/userdata                 flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,fsverity

# Boot & Recovery Partitions (A/B)
/boot               emmc      /dev/block/by-name/boot                     flags=display="Boot";slotselect;backup=1;flashimg=1
/init_boot          emmc      /dev/block/by-name/init_boot                flags=display="Init_Boot";slotselect;backup=1;flashimg=1
/vendor_boot        emmc      /dev/block/by-name/vendor_boot              flags=display="Vendor_Boot (Recovery)";slotselect;backup=1;flashimg=1
/dtbo               emmc      /dev/block/by-name/dtbo                     flags=display="DTBO";slotselect;backup=1;flashimg=1
/vbmeta             emmc      /dev/block/by-name/vbmeta                   flags=display="VBMeta";slotselect;backup=1;flashimg=1
/vbmeta_system      emmc      /dev/block/by-name/vbmeta_system            flags=display="VBMeta_System";slotselect;backup=1;flashimg=1
/vbmeta_vendor      emmc      /dev/block/by-name/vbmeta_vendor            flags=display="VBMeta_Vendor";slotselect;backup=1;flashimg=1

# Critical Calibration, IMEI & Persist Partitions
/persist            ext4      /dev/block/by-name/persist                  flags=display="Persist";backup=1
/nvram              emmc      /dev/block/by-name/nvram                    flags=display="NVRAM (IMEI)";backup=1;flashimg=1
/nvdata             ext4      /dev/block/by-name/nvdata                   flags=display="NVData (IMEI)";backup=1
/nvcfg              ext4      /dev/block/by-name/nvcfg                    flags=display="NVCFG";backup=1
/protect_f          ext4      /dev/block/by-name/protect1                 flags=display="Protect_F";backup=1
/protect_s          ext4      /dev/block/by-name/protect2                 flags=display="Protect_S";backup=1
/persistent         emmc      /dev/block/by-name/frp                      flags=display="FRP";backup=1
/para               emmc      /dev/block/by-name/para                     flags=display="Para"
/misc               emmc      /dev/block/by-name/misc                     flags=display="Misc"

# External Storage (MicroSD & USB-OTG)
/external_sd        auto      /devices/platform/soc/11240000.mmc*         flags=display="Tarjeta MicroSD";storage;wipeingui;removable
/usb_otg            auto      /devices/platform/soc/mt_usb*               flags=display="USB-OTG";storage;wipeingui;removable
